            ]
          },
          "docs": "Delete a specific eligibility requirement from the designated collaborator group."
        },
        {
          "info": {
            "name": "Retrieve Specific Collaborator Group Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wingspan.app/payments/collaborator-group/:id",
