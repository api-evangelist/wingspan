            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update specific details or attributes of an existing eligibility requirement."
        },
        {
          "info": {
            "name": "Remove a Specific Eligibility Requirement",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.wingspan.app/payments/collaborator-settings/eligibility-requirement/:id",
