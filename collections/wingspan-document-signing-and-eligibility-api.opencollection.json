          "docs": "Fetch detailed configuration and attributes associated with a specific collaborator group."
        },
        {
          "info": {
            "name": "Modify Collaborator Group Configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.wingspan.app/payments/collaborator-group/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
