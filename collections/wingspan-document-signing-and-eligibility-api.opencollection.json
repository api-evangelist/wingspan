            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wingspan.app/payments/collaborator-settings/eligibility-requirement"
          },
          "docs": "List and display all the set eligibility requirements for collaborators."
        },
        {
          "info": {
            "name": "Establish a new Eligibility Requirement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wingspan.app/payments/collaborator-settings/eligibility-requirement",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Define and create a new eligibility requirement for collaborators."
        },
        {
          "info": {
            "name": "Retrieve a Specific Eligibility Requirement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wingspan.app/payments/collaborator-settings/eligibility-requirement/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier"
              }
            ]
          },
          "docs": "Fetch details for a given eligibility requirement based on its unique identifier."
        },
        {
          "info": {
            "name": "Modify a Specific Eligibility Requirement",
