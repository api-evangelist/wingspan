        {
          "info": {
            "name": "Add a New Payment Eligibility Requirement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wingspan.app/payments/collaborator-settings/payment-eligibility",
            "body": {
              "type": "json",
              "data": "{}"
            }
