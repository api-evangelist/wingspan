        {
          "info": {
            "name": "Remove a specific Payment Eligibility Requirement",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.wingspan.app/payments/collaborator-settings/payment-eligibility/:id",
            "params": [
