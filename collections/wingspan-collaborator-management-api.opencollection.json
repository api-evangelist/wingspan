          "docs": "Fetch a comprehensive list of all collaborator groups created by the client, showcasing configurations and member details."
        },
        {
          "info": {
            "name": "Generate New Collaborator Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wingspan.app/payments/collaborator-group",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new collaborator group with specific configurations and permissions as defined by the client."
        },
        {
          "info": {
            "name": "Retrieve All Collaborators (Version 2)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wingspan.app/payments/v2/collaborator"
          },
          "docs": "Fetches a comprehensive list of collaborators formatted in the V2 standard, providing an overview of all collaborator data."
        },
        {
          "info": {
            "name": "Retrieve Specific Collaborator Details (Version 2)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wingspan.app/payments/v2/collaborator/:memberId",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of a member"
              }
            ]
          },
          "docs": "Fetches detailed information of a specific collaborator, identified by the memberId, in the V2 format."
        }
      ]
    }
  ],
  "bundled": true
}